# GEMINI_API_KEY: Required for AI itinerary generation (Gemini API).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional secondary AI provider key for OpenAI itinerary generation.
OPENAI_API_KEY=""

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps visualization, places search, and routing.
GOOGLE_MAPS_PLATFORM_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

